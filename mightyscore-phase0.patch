-}
-
-export function getInstallSnapshot(): InstallSnapshot {
-  return snapshot;
-}
-
-export async function promptInstall(): Promise<'accepted' | 'dismissed' | 'unavailable'> {
-  if (!deferredPrompt) return 'unavailable';
-  await deferredPrompt.prompt();
