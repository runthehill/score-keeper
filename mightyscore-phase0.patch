-    update({ hasPrompt: true, installed: snapshot.installed });
-  });
-  window.addEventListener('appinstalled', () => {
-    deferredPrompt = null;
-    update({ hasPrompt: false, installed: true });
-  });
-}
-
-export function subscribeInstall(cb: () => void): () => void {
-  listeners.add(cb);
